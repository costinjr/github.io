# Public site URL, used for metadata and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. The anon key is safe to expose to the client — RLS
# policies in supabase/migrations/0001_init.sql do the actual enforcement.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_ and never
# ship it to the client.
SUPABASE_SERVICE_ROLE_KEY=
